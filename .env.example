# Copy names only into Netlify > Site configuration > Environment variables.
# Never commit real values. Mark tokens as secret in the Netlify UI.

# Notion internal integration token (Settings > Connections > develop an integration).
# Share the integration with the Client Relation Manager database.
NOTION_TOKEN=

# Client Relation Manager database ID. Optional; the function already defaults to this database.
NOTION_LEADS_DATABASE_ID=249a7565993d80159485d17417432682

# Resend API key. Emails will not send without this and REPORT_FROM.
RESEND_API_KEY=

# From address on a domain you have verified in Resend, for example:
# PlanDepa <reports@your-verified-domain>
REPORT_FROM=

# Who receives every enquiry. Defaults to mitch@plandepa.com if left unset.
NOTIFY_TO=mitch@plandepa.com
